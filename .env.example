# Local development: with no MONGODB_URI, pages fetch data from the deployed
# functions at this origin. Point it at production to work against real data.
NEXT_PUBLIC_BASE_URL=https://nhatminh.dev

# Optional locally. When set, pages and scripts read MongoDB directly
# (this is how production runs). Get it from Netlify: `netlify env:get MONGODB_URI`.
MONGODB_URI=
MONGODB_DB=cv

# Required by the admin CSV upload (netlify/functions/upload-cv-data.ts).
UPLOAD_SECRET_KEY=your-secret

# eBay marketplace account-deletion webhook challenge.
EBAY_WEBHOOK_VERIFICATION_TOKEN=your-ebay-verification-token
EBAY_WEBHOOK_ENDPOINT=https://nhatminh.dev/.netlify/functions/ebay-account-deletion-webhook
