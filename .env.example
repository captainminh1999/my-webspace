# Local development: with no MONGODB_URI, pages fetch data from the deployed
# functions at this origin. Point it at production to work against real data.
NEXT_PUBLIC_BASE_URL=https://nhatminh.dev

# Optional locally. When set, pages and scripts read MongoDB directly
# (this is how production runs). Get it from Netlify: `netlify env:get MONGODB_URI`.
# The admin at /admin/upload needs it: passkeys and sessions live in the database.
MONGODB_URI=
# Production is `cv`. `cv_dev` keeps local uploads and local passkeys out of the live data.
# With MONGODB_URI set every page reads this database too, so under `cv_dev` the local dashboard
# and CV are empty until you upload into it. `cv` shows real data — and local uploads then write it.
MONGODB_DB=cv_dev

# Enrolment and recovery secret for the admin passkeys (src/lib/admin). Asked for once,
# while no passkey exists for this host; at least 16 characters. It no longer authorises
# uploads. Use a value of its own locally — never production's.
UPLOAD_SECRET_KEY=

# Bearer for POST /api/revalidate (scheduled feeds). Falls back to UPLOAD_SECRET_KEY
# when unset — give it its own value.
REVALIDATE_SECRET=

# eBay marketplace account-deletion webhook challenge.
EBAY_WEBHOOK_VERIFICATION_TOKEN=your-ebay-verification-token
EBAY_WEBHOOK_ENDPOINT=https://nhatminh.dev/.netlify/functions/ebay-account-deletion-webhook
